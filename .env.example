PORT=5001
MONGODB_URI=mongodb://localhost:27017/urbansprout

JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

ADMIN_NAME=your-admin-name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-FIREBASE-PRIVATE-KEY\n-----END PRIVATE KEY-----"

CORS_ORIGIN=http://localhost:5173

EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

FRONTEND_URL=http://localhost:5173

# Gemini (Space Planner)
# Put this in server/.env or server/.envnew (server loads those files).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_SPACE_PLANNER_MODEL=gemini-flash-latest
